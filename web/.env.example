# Copy to the static host's build environment (not a file in the repo). Read at build time only: it is baked into
# the bundle, so changing it needs a rebuild. Leave it unset only when the API is served from the same origin.
VITE_API_BASE=https://api.example.com

# OWCS Grid (docs/grid/BETA.md). /grid always works when visited directly. Set this to the exact string "true" to
# also show the "Daily Grid" link in the masthead; unset, or any other value, keeps it hidden. Build time only.
# VITE_GRID_NAV=true
