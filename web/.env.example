# Copy to the static host's build environment (not a file in the repo). Read at build time only: it is baked into
# the bundle, so changing it needs a rebuild. Leave it unset only when the API is served from the same origin.
VITE_API_BASE=https://api.example.com

# OWCS Grid (docs/grid/BETA.md). Muse links to it by default: "Daily Grid" in the masthead, and one line under the
# landing page's question box. Set this to the exact string "false" to hide both; /grid itself still works when
# visited directly. Unset, or any other value, shows them. Build time only.
# VITE_GRID_NAV=false
