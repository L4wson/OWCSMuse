# FACEIT Data API v4 server-side key (https://developers.faceit.com)
FACEIT_API_KEY=
# Postgres connection string, e.g. postgresql://user:password@host:5432/owcsmuse
DATABASE_URL=
# LiquipediaDB API v3 key (https://api.liquipedia.net). Requests are refused unless the process
# environment also sets OWCS_LIQUIPEDIA_ENABLED=1; the allowance is 60 requests per hour.
LIQUIPEDIA_API_KEY=
